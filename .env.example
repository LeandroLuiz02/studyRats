# Configuração do app Web do Firebase (Console do Firebase → Configurações do projeto → Seus apps).
# Copie este arquivo para .env.local e preencha com os valores reais.
# Esses valores NÃO são segredos tradicionais (vão para o bundle do cliente),
# mas ficam fora do controle de versão por organização (ver ADR 0002).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
